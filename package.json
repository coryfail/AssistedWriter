{
  "name": "assisted-writer",
  "version": "0.3.2",
  "private": true,
  "description": "An author-led desktop writing studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test test/*.test.cjs",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never"
  },
  "build": {
    "appId": "com.assistedwriter.desktop",
    "productName": "Assisted Writer",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "coryfail",
      "repo": "AssistedWriter"
    },
    "files": [
      "dist/**/*",
      "assets/fonts/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon-1024.png",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.0.0",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.0",
    "lucide-react": "^0.400.0",
    "marked": "^16.0.0",
    "openai": "^6.0.0",
    "pdfkit": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  }
}
